{
  "name": "sunhat",
  "version": "2.0.0",
  "description": "Project-bound Hardhat and Foundry CLI for EVM and TRON development",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "bin": {
    "sunhat": "bin/sunhat.js"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test test/cli.test.js test/init-commands.test.js",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
