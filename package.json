{
  "name": "@sun-protocol/sunhat",
  "version": "2.0.0",
  "description": "Project-bound Hardhat and Foundry CLI for EVM and TRON development",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "bin": {
    "sunhat": "bin/sunhat.js"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "docs/toml-binding.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && npm run test:runtime",
    "test:runtime": "node --test test/toml.test.js test/binding.test.js test/cli.test.js test/init-commands.test.js test/init-template-assets.test.js test/toolchain.test.js",
    "test:templates": "npm run build && node --test test/template-types.test.js",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.10.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-solidity": "2.4.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "smol-toml": "1.9.1"
  }
}
