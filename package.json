{
  "name": "@sun-protocol/sunhat",
  "version": "2.1.0",
  "description": "Project-bound Hardhat and Foundry CLI for EVM and TRON development",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "bin": {
    "sunhat": "bin/sunhat.js"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "config/tron-defaults.json",
    "docs/QuickStart.md",
    "README.md",
    "vendor/hardhat-tron/",
    "docs/hardhat3-tron-plugin.md",
    "docs/release-2.1.0.md"
  ],
  "engines": {
    "node": "^20.11.0 || ^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run build",
    "test": "npm run build && npm run test:runtime",
    "test:runtime": "node --test test/toml.test.js test/binding.test.js test/json-boundaries.test.js test/runtime.test.js test/process.test.js test/cli.test.js test/init-commands.test.js test/init-template-assets.test.js test/toolchain.test.js",
    "test:templates": "npm run build && node --test test/template-types.test.js",
    "test:hardhat3": "npm run build && node --test test/hardhat3.integration.test.js",
    "test:hardhat3:tron": "node --test test/hardhat3-tron.integration.test.js",
    "pack:check": "npm run clean && node --test test/package.test.js",
    "test:tron-core": "node --test test/tron-core.test.js test/tron-addresses.test.js test/tron-reverts.test.js test/tron-predictions.test.js test/tron-balances.test.js test/tron-transport.test.js test/tron-capabilities.test.js test/tron-abi.test.js",
    "test:hardhat3:tron-plugin": "npm run build && node --test test/hardhat3-tron-plugin.integration.test.js",
    "tre:build-jar": "bash scripts/build-tre-jar.sh",
    "test:tron-plugin": "node --test test/tron-core.test.js test/tron-addresses.test.js test/tron-reverts.test.js test/tron-predictions.test.js test/tron-balances.test.js test/tron-transport.test.js test/tron-capabilities.test.js test/tron-abi.test.js test/tron-artifacts.test.js test/tron-plugin.test.js",
    "test:hardhat3:tron-template": "npm run build && node --test test/hardhat3-tron-template.integration.test.js",
    "check:english": "node scripts/check-english.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nomicfoundation/hardhat-ethers": "4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-mocha": "4.0.1",
    "@openzeppelin/tron-runtime": "0.1.0",
    "@types/chai": "5.2.2",
    "@types/node": "22.10.2",
    "chai": "5.3.3",
    "eslint": "10.13.0",
    "ethers": "6.17.0",
    "globals": "17.13.0",
    "hardhat": "3.21.1",
    "mocha": "12.0.3",
    "prettier": "3.9.10",
    "prettier-plugin-solidity": "2.4.1",
    "solc": "0.8.26",
    "tronweb": "6.5.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "smol-toml": "1.9.1",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@nomicfoundation/hardhat-ethers": "*",
    "@openzeppelin/tron-runtime": "*",
    "ethers": "*",
    "hardhat": "*",
    "solc": "*",
    "tronweb": "*",
    "@nomicfoundation/hardhat-mocha": "*"
  },
  "peerDependenciesMeta": {
    "hardhat": {
      "optional": true
    },
    "@nomicfoundation/hardhat-ethers": {
      "optional": true
    },
    "ethers": {
      "optional": true
    },
    "@openzeppelin/tron-runtime": {
      "optional": true
    },
    "tronweb": {
      "optional": true
    },
    "solc": {
      "optional": true
    },
    "@nomicfoundation/hardhat-mocha": {
      "optional": true
    }
  },
  "exports": {
    "./hardhat3-tron": {
      "types": "./dist/plugins/tron/index.d.ts",
      "import": "./dist/plugins/tron/index.js",
      "default": "./dist/plugins/tron/index.js"
    },
    "./package.json": "./package.json"
  }
}
