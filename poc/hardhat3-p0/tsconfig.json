{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "types": ["node", "mocha"],
    "skipLibCheck": true
  },
  "include": [
    "hardhat.config.ts",
    "../../src/v2/**/*.ts",
    "../../test-v2/**/*.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "p0-tests/**/*.ts"
  ]
}
